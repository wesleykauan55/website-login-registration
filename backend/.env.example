# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" pro GitHub.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=site_db

# Gere uma string aleatória grande, ex: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_bem_grande_e_aleatoria

# URL de onde o front-end (seu HTML/CSS/JS) está rodando
CORS_ORIGIN=http://127.0.0.1:5500
